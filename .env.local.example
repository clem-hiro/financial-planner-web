# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored (see .gitignore line 34 — `.env*`). Never commit it.

# --- Supabase (required for app + seed scripts) ---

# Project URL — found in Supabase Dashboard → Project Settings → API → "Project URL".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key — Dashboard → Project Settings → API → "Project API keys" → anon.
# Safe to expose in the browser bundle; subject to RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...replace-with-anon-key

# Service-role key — Dashboard → Project Settings → API → "Project API keys" → service_role.
# WARNING: bypasses RLS. ONLY consumed by dev tooling under `scripts/` (e.g. `npm run seed:dev`).
# Never imported from `src/`. Never prefix with `NEXT_PUBLIC_`. Rotate immediately if leaked.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...replace-with-service-role-key

# --- App UI flags ---

# Client UI version flag (cache-busting / feature gating). Bump to invalidate clients.
NEXT_PUBLIC_CLIENT_UI_VERSION=1


SITE_URL=https://your-site-url.com