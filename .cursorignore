# =============================================================================
# .cursorignore — finance-planner-web
# Reduces Cursor indexing load (CPU / fan spikes) by excluding heavy, generated,
# and sensitive paths. Syntax matches .gitignore.
#
# After editing: Cmd+Shift+P → "Cursor: Reindex" (or restart Cursor).
# =============================================================================

# -----------------------------------------------------------------------------
# Dependencies (largest CPU offenders)
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.js
.pnp.*
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.yarn-integrity
vendor/
bower_components/
jspm_packages/

# Python / Ruby / PHP / Java deps (monorepos / tooling)
.venv/
venv/
env/
__pycache__/
*.py[cod]
.Python
pip-wheel-metadata/
*.egg-info/
.eggs/
.bundle/
vendor/bundle/

# -----------------------------------------------------------------------------
# Build outputs & framework caches
# -----------------------------------------------------------------------------
.next/
**/.next/
out/
dist/
build/
.output/
.nuxt/
.nitro/
.svelte-kit/
.astro/
.remix/
.parcel-cache/
.cache/
.vite/
.turbo/
.vercel/
.netlify/
.firebase/
.open-next/
storybook-static/
.docusaurus/
.angular/
.expo/
.expo-shared/
web-build/

# TypeScript / compiler artifacts
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Package-manager lockfiles (large, rarely needed for AI context)
# -----------------------------------------------------------------------------
package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml
bun.lockb
composer.lock
Gemfile.lock
poetry.lock
Pipfile.lock
Cargo.lock
go.sum
mix.lock

# -----------------------------------------------------------------------------
# Logs, dumps & temp files
# -----------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
pnpm-debug.log*
*.log.*
logs/
**/logs/
tmp/
temp/
.tmp/
.temp/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.pid
*.seed
*.pid.lock
core
core.*

# -----------------------------------------------------------------------------
# Environment, secrets & credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.local.example
!.env*.example
**/.env
**/.env.*
credentials.json
secrets.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_dsa
id_ed25519
id_ed25519.*
.npmrc
.pypirc
.netrc
.mcp.json

# -----------------------------------------------------------------------------
# Test & coverage artifacts (keep source tests; ignore generated output)
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.hypothesis/
junit.xml
test-results/
playwright-report/
blob-report/
playwright/.cache/
cypress/videos/
cypress/screenshots/
cypress/downloads/

# -----------------------------------------------------------------------------
# Version control & worktrees
# -----------------------------------------------------------------------------
.git/
**/.git/
.svn/
.hg/
.bzr/
.worktrees/
**/.worktrees/

